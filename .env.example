# Copy to .env for Docker Compose model selection.
# For Python, export these variables in your shell; .env is not loaded automatically.
ESCRIBA_MODEL=small
ESCRIBA_DEVICE=cpu
ESCRIBA_COMPUTE_TYPE=int8
ESCRIBA_DATA_DIR=./data
ESCRIBA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# For a remote server, use HTTPS, explicitly list your domain above and set a random token (32+ chars).
# ESCRIBA_ACCESS_TOKEN=
# Optional installed Unicode font path; do not commit font files or personal audio.
# ESCRIBA_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
